# Diese Datei ist nur die Vorlage. Im Regelfall nicht von Hand kopieren,
# sondern ./vorbereiten.sh aufrufen – es erzeugt alle Geheimnisse und traegt
# sie an den richtigen Stellen ein.

# Verbindung zur lokalen PostgreSQL-Instanz (niemals extern erreichbar machen).
#
# ACHTUNG: Das Passwort steht hier in einer URL. Zeichen wie "/", "+", "@", ":"
# oder "#" zerlegen sie. Ein "/" fuehrt zu der irrefuehrenden Meldung
# "P1013 ... invalid port number in database URL", obwohl der Port stimmt.
# Deshalb nur [A-Za-z0-9] verwenden, etwa aus `openssl rand -hex 24` –
# NICHT aus `openssl rand -base64 24`.
DATABASE_URL="postgresql://brapp:CHANGEME@db:5432/brcockpit?schema=public"

# Signaturschluessel fuer Sitzungstokens – mit `openssl rand -hex 32` erzeugen
AUTH_SECRET="CHANGEME"

# Schluessel fuer die verschluesselte Dokumentenablage (AES-256-GCM), 64 Hex-Zeichen.
# Wird ausserhalb der Datenbank verwahrt, damit ein Datenbank-Backup allein
# keine Betriebsratsdokumente offenlegt (§ 79 BetrVG, Art. 32 DSGVO).
DOKUMENT_SCHLUESSEL="CHANGEME"

# Ablageort der verschluesselten Dateien
DATA_DIR="/var/lib/br-cockpit/data"

# Bundesland fuer die Feiertags- und Fristberechnung (NW = Nordrhein-Westfalen)
BUNDESLAND="NW"

# Erreichbarkeit des Anwendungsports auf dem Host.
# Vorgabe 127.0.0.1: nur auf dem Server selbst; nach aussen veroeffentlicht ein
# Reverse Proxy mit TLS. Fuer einen ersten Test ohne Reverse Proxy auf 0.0.0.0
# setzen – dann unverschluesselt und ohne echte Betriebsratsdaten.
BINDUNG=127.0.0.1
PORT_AUSSEN=3000

# Nur setzen, wenn Formulare (Server Actions, z. B. die Anmeldung) hinter dem
# eigenen Reverse Proxy mit "Invalid Server Actions request" scheitern.
# Kommagetrennte Liste der extern sichtbaren Adresse(n), z. B.
# ZUSAETZLICHE_SERVER_ACTION_URSPRUENGE="betriebsrat.betrieb.intern"
ZUSAETZLICHE_SERVER_ACTION_URSPRUENGE=""
